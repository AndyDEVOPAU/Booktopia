{
  "info": {
    "name": "Book & Category CRUD API",
    "description": "Tests public reads, admin-only writes, and soft-delete/restore for /api/categories and /api/books. Uses cookie-based auth (authMiddleware reads req.cookies.token) — Postman's cookie jar handles this automatically after each login, no Authorization header needed. IMPORTANT: run 'Login - Admin' with an account you've already manually promoted to role: 'admin' in the DB; there's no API route that grants admin. Run folders top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Setup: Auth",
      "item": [
        {
          "name": "Register - Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Tester\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 409 (already exists is fine on rerun)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Customer (sets cookie)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('token cookie was set', function () {",
                  "    pm.expect(pm.cookies.has('token')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Admin (sets cookie) - requires manual DB role flip first",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('token cookie was set', function () {",
                  "    pm.expect(pm.cookies.has('token')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Public Reads (no login needed)",
      "item": [
        {
          "name": "GET Categories - Public",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Books - Public",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has books array', function () {",
                  "    pm.expect(pm.response.json().books).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Writes Blocked for Guest/Customer",
      "item": [
        {
          "name": "POST Category as Guest (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Not Be Created\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Category as Logged-in Customer (expect 403, not 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Not Be Created Either\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (proves role check runs, not just login check)', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run '0 - Setup / Login - Customer' immediately before this folder so the customer cookie is active, not the admin one."
    },
    {
      "name": "3 - Admin CRUD - Category",
      "item": [
        {
          "name": "POST Category as Admin (expect 201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testCategoryName}}\",\n  \"description\": \"Created by Postman test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Has auto-generated slug', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.slug).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('categoryId', json._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Category - Duplicate Name (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testCategoryName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Category as Admin (expect 200)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated by Postman test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Description was updated', function () {",
                  "    pm.expect(pm.response.json().description).to.eql('Updated by Postman test');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE Category as Admin - soft delete (expect 200)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Categories - Public - archived one is hidden",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Archived category is not in public list', function () {",
                  "    var ids = pm.response.json().map(function (c) { return c._id; });",
                  "    pm.expect(ids).to.not.include(pm.collectionVariables.get('categoryId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Archived Categories as Admin (expect to see it)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/archived",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "archived"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Archived category shows up here', function () {",
                  "    var ids = pm.response.json().map(function (c) { return c._id; });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('categoryId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Archived Categories as Customer (expect 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/archived",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "archived"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (must be logged in as customer for this request)', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Restore Category as Admin (expect 200)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}", "restore"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('isActive is true again', function () {",
                  "    pm.expect(pm.response.json().category.isActive).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run '0 - Setup / Login - Admin' immediately before this folder."
    },
    {
      "name": "4 - Admin CRUD - Book",
      "item": [
        {
          "name": "POST Book as Admin (expect 201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"price\": 15.99,\n  \"stock\": 5,\n  \"category\": \"{{categoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Book created with correct category ref', function () {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('bookId', json._id);",
                  "    pm.expect(json.category).to.eql(pm.collectionVariables.get('categoryId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Book - Missing Required Field (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Incomplete Book\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Book - Duplicate ISBN (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune (Reissue)\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"price\": 12.99,\n  \"stock\": 2,\n  \"category\": \"{{categoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Book by Id - Public, category populated",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Category is populated with a name', function () {",
                  "    pm.expect(pm.response.json().category.name).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Books filtered by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?category={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [{ "key": "category", "value": "{{categoryId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returned book matches the filtered category', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.books.length).to.be.above(0);",
                  "    json.books.forEach(function (b) {",
                  "        pm.expect(b.category._id).to.eql(pm.collectionVariables.get('categoryId'));",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Book as Admin - update stock (expect 200)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Stock updated', function () {",
                  "    pm.expect(pm.response.json().stock).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE Book as Admin - soft delete (expect 200)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Books - Public - archived book is hidden",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Archived book is not in public list', function () {",
                  "    var ids = pm.response.json().books.map(function (b) { return b._id; });",
                  "    pm.expect(ids).to.not.include(pm.collectionVariables.get('bookId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Restore Book as Admin (expect 200)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}", "restore"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('isActive is true again', function () {",
                  "    pm.expect(pm.response.json().book.isActive).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run '0 - Setup / Login - Admin' immediately before this folder if not already active."
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "customerEmail", "value": "customer.tester@example.com" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "password123" },
    { "key": "testCategoryName", "value": "Postman Test Category" },
    { "key": "testIsbn", "value": "9780441013593" },
    { "key": "categoryId", "value": "" },
    { "key": "bookId", "value": "" }
  ]
}